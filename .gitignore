# When the repo is cloned into the ClipLab home folder (the default), keep its data out of git.
Inbox/
Ready/
Tossed/
Failed/
work/
requests/
logs/
thumbs/
bin/
syncthing/
processed.json
status.json
heartbeat
config.json
decisions.json
*.tmp
__pycache__/
.stfolder/
.stignore

# clipper/: local settings, password file, logs
clipper/config.json
clipper/tmp/
clipper/*.log
clipper/*.log.old
*password*.txt

# updates (see cliplab/updater.py), models and sounds ClipLab downloads or makes, release builds
backups/
updates/
models/
sounds/
dist/
.cliplab-files
